# Frontend Environment Configuration
# Copy this file to .env and fill in your actual values

# Backend API URL
REACT_APP_BACKEND_URL=http://localhost:8000

# WebSocket URL (usually same as backend but ws:// or wss://)
REACT_APP_WS_URL=ws://localhost:8000

# Application Settings
REACT_APP_APP_NAME=SYNTHESUS IDE
REACT_APP_VERSION=1.0.0

# Features (set to 'true' to enable)
REACT_APP_ENABLE_COLLABORATION=true
REACT_APP_ENABLE_VIDEO_CHAT=true
REACT_APP_ENABLE_BROWSER_PREVIEW=true

# Default AI Settings (can be overridden by user)
REACT_APP_DEFAULT_AI_BACKEND=ollama
REACT_APP_DEFAULT_AI_MODEL=llama3.2

# Optional: Sentry DSN for error tracking
# REACT_APP_SENTRY_DSN=your-sentry-dsn-here

# Optional: Analytics
# REACT_APP_ANALYTICS_ID=your-analytics-id

# Build Settings (for CI/CD)
# REACT_APP_BUILD_NUMBER=
# REACT_APP_COMMIT_SHA=
